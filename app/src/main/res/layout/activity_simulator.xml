<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/simulatorRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Eyebrow" android:text="@string/ui_smart_lock_android_b" />
        <TextView style="@style/ScreenTitle" android:text="@string/ui_punto_de_acceso" />
        <TextView android:id="@+id/simEmail" style="@style/Caption" />
        <TextView style="@style/BodyCopy" android:layout_marginTop="16dp" android:text="@string/ui_simula_una_lectura_rfid_la_autorizacion_se_valida_con_e" />
        <com.google.android.material.card.MaterialCardView style="@style/Panel">
            <LinearLayout style="@style/PanelContent">
                <TextView style="@style/Eyebrow" android:text="@string/ui_simulacion_sin_accionamiento_fisico" />
                <TextView style="@style/SectionTitle" android:text="@string/ui_presenta_tu_credencial" />
                <EditText android:id="@+id/simUid" style="@style/FormField" android:hint="@string/ui_uid_rfid_04_a3_9c_21" android:inputType="textCapCharacters" android:saveEnabled="false" android:importantForAutofill="no" />
                <Button android:id="@+id/btnReadAccessNfc"
                    style="@style/SecondaryAction"
                    android:text="@string/nfc_read"
                    android:enabled="false" />
                <TextView style="@style/Caption" android:text="@string/ui_ejemplos_de_prueba_el_resultado_depende_de_las_credenci" />
                <Button android:id="@+id/btnExampleActive" style="@style/SecondaryAction" android:text="@string/ui_usar_uid_de_valentina" />
                <Button android:id="@+id/btnExampleUnknown" style="@style/SecondaryAction" android:text="@string/ui_usar_uid_ffffffff" />
                <Button android:id="@+id/btnSimulate" style="@style/PrimaryAction" android:text="@string/ui_simular_lectura" android:enabled="false" />
                <ProgressBar android:id="@+id/simProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Panel">
            <LinearLayout style="@style/PanelContent">
                <TextView android:id="@+id/simResult" style="@style/SectionTitle" android:text="@string/ui_listo_para_validar" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/simDetail" style="@style/BodyCopy" android:text="@string/ui_los_accesos_permitidos_y_rechazados_apareceran_en_el_hi" android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/simConnection" style="@style/Caption" android:text="@string/ui_verificando_conexion" />
        <Button android:id="@+id/btnBackAdmin" style="@style/SecondaryAction" android:text="@string/ui_volver_al_administrador" android:visibility="gone" />
        <Button android:id="@+id/btnSimLogout" style="@style/SecondaryAction" android:text="@string/ui_cerrar_sesion" />
    </LinearLayout>
</ScrollView>
