<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/simulatorRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/page">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView style="@style/Eyebrow" android:text="SMART LOCK / ANDROID B" />
  <TextView style="@style/ScreenTitle" android:text="Punto de acceso" />
  <TextView android:id="@+id/simEmail" style="@style/Caption" />
  <TextView style="@style/BodyCopy" android:layout_marginTop="16dp" android:text="Simula una lectura RFID. La autorización se valida con el estado actual de la credencial en Firebase." />
  <com.google.android.material.card.MaterialCardView style="@style/Panel"><LinearLayout style="@style/PanelContent">
   <TextView style="@style/Eyebrow" android:text="SIMULACIÓN / SIN ACCIONAMIENTO FÍSICO" />
   <TextView style="@style/SectionTitle" android:text="Presenta tu credencial" />
   <EditText android:id="@+id/simUid" style="@style/FormField" android:hint="UID RFID · 04:A3:9C:21" android:inputType="textCapCharacters" android:saveEnabled="false" android:importantForAutofill="no" />
   <TextView style="@style/Caption" android:text="Ejemplos de prueba. El resultado depende de las credenciales registradas." />
   <Button android:id="@+id/btnExampleActive" style="@style/SecondaryAction" android:text="Usar UID de Valentina" />
   <Button android:id="@+id/btnExampleUnknown" style="@style/SecondaryAction" android:text="Usar UID FFFFFFFF" />
   <Button android:id="@+id/btnSimulate" style="@style/PrimaryAction" android:text="Simular lectura" android:enabled="false" />
   <ProgressBar android:id="@+id/simProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
  </LinearLayout></com.google.android.material.card.MaterialCardView>
  <com.google.android.material.card.MaterialCardView style="@style/Panel"><LinearLayout style="@style/PanelContent">
   <TextView android:id="@+id/simResult" style="@style/SectionTitle" android:text="Listo para validar" android:accessibilityLiveRegion="polite" />
   <TextView android:id="@+id/simDetail" style="@style/BodyCopy" android:text="Los accesos permitidos y rechazados aparecerán en el historial del administrador." android:textIsSelectable="true" />
  </LinearLayout></com.google.android.material.card.MaterialCardView>
  <TextView android:id="@+id/simConnection" style="@style/Caption" android:text="Verificando conexión…" />
  <Button android:id="@+id/btnBackAdmin" style="@style/SecondaryAction" android:text="Volver al administrador" android:visibility="gone" />
  <Button android:id="@+id/btnSimLogout" style="@style/SecondaryAction" android:text="Cerrar sesión" />
 </LinearLayout>
</ScrollView>