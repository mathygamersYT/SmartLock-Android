<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/loginRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/page" android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical">
        <TextView style="@style/Eyebrow" android:text="@string/ui_rfid_seguridad_trazabilidad" />
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_marginBottom="20dp" android:src="@drawable/ic_smartlock" android:contentDescription="@string/app_name" />
        <TextView style="@style/ScreenTitle" android:text="@string/app_name" android:textSize="42sp" />
        <TextView style="@style/BodyCopy" android:text="@string/ui_cada_acceso_cuenta_ngestiona_credenciales_y_consulta_lo" />
        <com.google.android.material.card.MaterialCardView style="@style/Panel">
            <LinearLayout style="@style/PanelContent">
                <TextView style="@style/SectionTitle" android:text="@string/ui_bienvenido" />
                <TextView style="@style/Caption" android:text="@string/ui_ingresa_con_tu_cuenta_de_administrador_o_simulador" />
                <EditText android:id="@+id/etEmail" style="@style/FormField" android:hint="@string/ui_correo_electronico" android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
                <EditText android:id="@+id/etPassword" style="@style/FormField" android:hint="@string/ui_contrasena" android:inputType="textPassword" android:autofillHints="password" android:saveEnabled="false" />
                <ProgressBar android:id="@+id/authProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
                <TextView android:id="@+id/tvAuthStatus" style="@style/BodyCopy" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/btnLogin" style="@style/PrimaryAction" android:text="@string/ui_iniciar_sesion" />
                <Button android:id="@+id/btnRegister" style="@style/SecondaryAction" android:text="@string/ui_crear_cuenta" />
                <Button android:id="@+id/btnResetPassword" style="@style/TabAction" android:layout_width="match_parent" android:text="@string/ui_olvide_mi_contrasena" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/Caption" android:text="@string/ui_una_cuenta_nueva_requiere_habilitacion_del_responsable_" />
    </LinearLayout>
</ScrollView>