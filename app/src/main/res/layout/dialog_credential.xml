<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/PanelContent">
    <TextView style="@style/BodyCopy" android:text="@string/ui_el_uid_identifica_la_tarjeta_y_no_se_modifica_despues_d" />
    <EditText android:id="@+id/holderInput" style="@style/FormField" android:hint="@string/ui_nombre_del_titular" android:inputType="textCapWords" android:autofillHints="personName" android:maxLength="80" />
    <EditText android:id="@+id/rfidInput" style="@style/FormField" android:hint="@string/ui_uid_rfid_hexadecimal" android:inputType="textCapCharacters" android:saveEnabled="false" android:importantForAutofill="no" />
    <TextView style="@style/Caption" android:text="@string/ui_usa_8_14_o_20_digitos_hexadecimales_4_7_o_10_bytes" />
    <Button
        android:id="@+id/btnReadCredentialNfc"
        style="@style/SecondaryAction"
        android:text="@string/nfc_read" />
    <Button
        android:id="@+id/btnWriteCredentialNfc"
        style="@style/SecondaryAction"
        android:text="@string/nfc_write" />
    <TextView
        android:id="@+id/nfcWriteStatus"
        style="@style/Caption"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
