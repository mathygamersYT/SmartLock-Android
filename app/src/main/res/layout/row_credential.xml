<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" style="@style/Panel">
    <LinearLayout style="@style/PanelContent">
        <TextView android:id="@+id/credentialName" style="@style/SectionTitle" tools:text="Valentina Pérez" />
        <TextView android:id="@+id/credentialUid" style="@style/Caption" tools:text="•••• 9C21" />
        <TextView android:id="@+id/credentialState" style="@style/BodyCopy" tools:text="Activa" />
        <Button android:id="@+id/viewCredential" style="@style/SecondaryAction" android:text="@string/ui_ver_detalle" />
        <Button android:id="@+id/editCredential" style="@style/SecondaryAction" android:text="@string/edit_holder" />
        <Button android:id="@+id/toggleCredential" style="@style/SecondaryAction" tools:text="Revocar acceso" />
        <Button android:id="@+id/deleteCredential" style="@style/SecondaryAction" android:textColor="@color/danger" android:text="@string/delete_card" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>